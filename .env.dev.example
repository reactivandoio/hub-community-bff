# Desenvolvimento em Docker (REA-21). O make dev copia este arquivo para .env.dev (fora do git).
# Sem segredo nenhum aqui: tokens e chaves reais só no seu .env.dev.
# Dentro do container o .env é o .env.dev; o .env da máquina não é lido.
NODE_ENV=development

# Strapi do Hub (hub-community-backend). Local: rode make dev lá.
# Produção: MANAGER_URL=https://manager.hubcommunity.io
MANAGER_URL=http://host.docker.internal:1340
# Local: http://localhost:1340/admin -> Settings -> API Tokens -> Full access
MANAGER_TOKEN_INTEGRATION=

# Igual ao JWT_SECRET do backend (o do .env.dev.example de lá, para o backend local).
JWT_SECRET=dev-only-jwt-secret

# Eventando (eventando-manager). Local: rode make dev lá.
# Produção: EVENTANDO_MANAGER_URL=https://eventando.hubcommunity.io
EVENTANDO_MANAGER_URL=http://host.docker.internal:1341
# Local: http://localhost:1341/admin -> Settings -> API Tokens -> Full access
EVENTANDO_MANAGER_TOKEN_INTEGRATION=

# Frontend local (make dev no hub-community-frontend)
FRONTEND_URL=http://localhost:4010

# E-mail: sem credenciais o envio falha e só aparece no log; nada sai para ninguém.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Hub Community <dev@localhost>
EMAIL_REPLY_TO=dev@localhost

OPAPINGOU_ENABLED=false
OPAPINGOU_WEBHOOK_SECRET=
OPAPINGOU_ACCEPT_TEST_MODE=true

# Se a recarga de código não pegar alterações (alguns setups de macOS), ligue o polling:
# CHOKIDAR_USEPOLLING=true

NODE_ENV=development
# REA-35: true só em desenvolvimento. Põe stacktrace e detalhes internos nas respostas de erro
# (GraphQL e REST). Ausente ou qualquer outro valor: só mensagem e código; o detalhe fica no log.
EXPOSE_ERROR_DETAILS=false
MANAGER_URL="https://manager.hubcommunity.io"
MANAGER_TOKEN_INTEGRATION=create-your-token-strapi

# AUTH
# Same value as JWT_SECRET of hub-community-backend (users-permissions signs the user
# tokens with it). Without it every request is anonymous.
JWT_SECRET=

EVENTANDO_MANAGER_URL="https://eventando.hubcommunity.io"
EVENTANDO_MANAGER_TOKEN_INTEGRATION=talk-community-manager-to-get-your-key
PORT=

# EMAIL / SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Hub Community <contato@8020digital.com.br>
EMAIL_REPLY_TO=contato@8020digital.com.br

# E-MAIL MARKETING DOS EVENTOS (REA-29): fila de campanhas, uma vez por minuto.
# Desligado = nenhuma campanha começa nem é enviada (prévia e teste continuam).
EMAIL_CAMPAIGNS_ENABLED=false
# Assina o link de descadastro (secret do GitHub; trocar invalida os links já enviados)
EMAIL_UNSUBSCRIBE_SECRET=
# COTA DO MAILGUN (REA-26). Todo e-mail enviado conta. Códigos de login e transacionais nunca são
# barrados; campanhas e e-mails da revisão de idade só usam EMAIL_DAILY_LIMIT - EMAIL_DAILY_RESERVE
# menos o que já saiu no dia. Ao trocar de plano no Mailgun, mude só estes números.
EMAIL_DAILY_LIMIT=100
EMAIL_DAILY_RESERVE=30
# REA-50: limite do mês para o Hub (a conta do Mailgun é dividida com outros sistemas). As campanhas
# e os e-mails de idade param em EMAIL_MONTHLY_LIMIT - EMAIL_DAILY_RESERVE, contando todo e-mail do
# mês; códigos e transacionais continuam saindo mesmo depois. Vazio = sem limite mensal.
EMAIL_MONTHLY_LIMIT=
# Se definido, TODO e-mail de campanha vai para este endereço (testes/homologação).
EMAIL_CAMPAIGN_REDIRECT_TO=

# IA NO E-MAIL MARKETING (REA-51): textos gerados por runs do termhub, com o token de cada admin.
# Chave (32 bytes, hex ou base64) que criptografa os tokens no banco; só o BFF a tem. Sem ela, a
# configuração de IA não salva nada. Gere e grave no GitHub com scripts/termhub/configurar.sh.
# Trocar a chave invalida os tokens salvos (cada admin cola o token de novo).
TERMHUB_TOKEN_KEY=
TERMHUB_URL=https://termhub.dev

# FRONTEND
FRONTEND_URL=http://localhost:3000

# ADMIN: quem é admin é a role "admin" do users-permissions no Strapi do Hub (REA-10);
# não existe mais lista de e-mails.

# OPA PINGOU (REA-6): webhook POST /webhooks/opapingou. Desligado = rota 404 e nada muda.
OPAPINGOU_ENABLED=false
# Segredo whsec_ do endpoint cadastrado no Opa Pingou (secret do GitHub; nunca no repositório)
OPAPINGOU_WEBHOOK_SECRET=
# true só fora de produção: aceita eventos testMode (contas sandbox)
OPAPINGOU_ACCEPT_TEST_MODE=false
# Reembolso manual pelo suporte; sem número, a tela não mostra o contato
REFUND_SUPPORT_TEXT=
REFUND_SUPPORT_WHATSAPP=
# REA-52: webhook de eventos do Mailgun (POST /webhooks/mailgun) — entregue, aberto, clicado, falha,
# spam, descadastro. É a "HTTP webhook signing key" da conta (Mailgun → Settings → Security / API
# security → Webhook signing key). Sem ela o webhook responde 503 e o resto funciona.
MAILGUN_WEBHOOK_SIGNING_KEY=

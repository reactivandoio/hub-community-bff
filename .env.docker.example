# Overrides applied on top of .env ONLY when running via docker-compose.hub.yml.
# Copy to .env.docker (gitignored) and fill in after creating the tokens in each local admin.

# LOCAL hub Strapi: http://localhost:1340/admin -> Settings -> API Tokens -> Full access
MANAGER_TOKEN_INTEGRATION=

# LOCAL Eventando Strapi: http://localhost:1341/admin -> Settings -> API Tokens -> Full access
EVENTANDO_MANAGER_TOKEN_INTEGRATION=

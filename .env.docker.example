# Overrides applied on top of .env ONLY when running via docker-compose.hub.yml.
# Copy to .env.docker (gitignored) and fill in.

# API token created in the LOCAL Strapi admin (http://localhost:1340/admin → Settings → API Tokens, Full access)
MANAGER_TOKEN_INTEGRATION=

# Eventando Manager (production is fine — it only receives requests)
EVENTANDO_MANAGER_URL=https://
EVENTANDO_MANAGER_TOKEN_INTEGRATION=
